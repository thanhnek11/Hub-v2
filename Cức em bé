-- Hàm lọc chính xác chỉ người chơi BÊN TRONG BÁN KÍNH FOV
local function getEnemyInCenterFOV()
    local radius = tonumber(FOVRadiusInput.Text) or 120
    local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closestHead = nil
    local closestDist = math.huge

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if teamCheck and plr.Team == LocalPlayer.Team then continue end
            
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if killCheck and (not hum or hum.Health <= 0) then continue end
            
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    -- Tính khoảng cách tuyệt đối đến tâm màn hình
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                    
                    -- BẮT BUỘC KHỎANG CÁCH PHẢI NẰM TRONG BÁN KÍNH FOV
                    if dist <= radius then
                        if wallCheck then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, plr.Character}
                            local rayResult = workspace:Raycast(Camera.CFrame.Position, head.Position - Camera.CFrame.Position, rayParams)
                            if rayResult then continue end
                        end

                        if dist < closestDist then
                            closestDist = dist
                            closestHead = head
                        end
                    end
                end
            end
        end
    end
    return closestHead
end

RunService.RenderStepped:Connect(function()
    local centerPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local radius = tonumber(FOVRadiusInput.Text) or 120
    
    fovCircle.Visible = showFOVCircle
    fovCircle.Radius = radius
    fovCircle.Position = centerPos

    if silentAimActive then
        local targetHead = getEnemyInCenterFOV()
        if targetHead then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            if smoothAimActive then
                local smoothSpeed = tonumber(SmoothSpeedInput.Text) or 0.15
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(smoothSpeed, 0.01, 1))
            else
                Camera.CFrame = targetCFrame
            end
        end
    end
end)

