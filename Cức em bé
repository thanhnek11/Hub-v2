local function removeESP(plr)
    if espCache[plr] then
        if espCache[plr].Box then espCache[plr].Box:Destroy() end
        if espCache[plr].Tracer then espCache[plr].Tracer:Remove() end
        if espCache[plr].Skeleton then
            for _, l in pairs(espCache[plr].Skeleton) do l:Remove() end
        end
        espCache[plr] = nil
    end
end

